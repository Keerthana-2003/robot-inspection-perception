<?xml version="1.0"?>
<package format="3">
  <name>inspection_perception_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 node running the robot inspection perception pipeline (detection, tracking, LiDAR fusion, thermal hotspots, PTZ commands).</description>
  <maintainer email="keerthanam2k3@gmail.com">Keerthana Mandadi</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
